# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# Used by `nuxt dev` (Node) and `wrangler dev` (local Worker).
# Production: non-secret values live in wrangler.jsonc "vars"; push SMTP_PASS with `npm run secrets`.

SMTP_HOST=az1-sr5.supercp.com
SMTP_PORT=465
# true = implicit TLS (465), false = STARTTLS (587)
SMTP_SECURE=true
SMTP_USER=notify@morphe.co.ke
SMTP_PASS=

CONTACT_FROM=notify@morphe.co.ke
CONTACT_FROM_NAME=Morphe Creatives
# Where new inquiries are delivered
CONTACT_TO=hello@morphe.co.ke
# Send a confirmation email to the person who filled in the form
CONTACT_AUTOREPLY=true
